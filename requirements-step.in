# Рендер STEP-моделей в картинку для карточки компонента.
#
# Вынесено из requirements.in намеренно. OCP — это сборка OpenCascade,
# полноценное ядро CAD: пакет с зависимостями тянет больше гигабайта и
# увеличивает образ в несколько раз. Платить этим за функцию, которой
# пользуется один человек в неделю, стоит осознанно, а не потому, что
# строка случайно оказалась в общем файле.
#
# Без этих пакетов работает всё, кроме самого рендера: загрузка STEP
# отвечает «рендер не установлен» и компонент сохраняется как обычно.
#
# Поставить рядом с основными:
#
#     pip install -r requirements-step.txt
#
# В Docker — отдельным слоем, см. docs/components.md, «Изображение из STEP».
# Там же про системные библиотеки: pyvista рисует через VTK, которому на
# сервере без экрана нужны libgl1, libxrender1, libxext6 и xvfb.

cadquery-ocp>=7.7     # OpenCascade: чтение STEP вместе с цветами
pyvista>=0.44         # триангуляция в картинку, рендер без экрана
numpy>=1.26           # массивы точек и треугольников для pyvista
